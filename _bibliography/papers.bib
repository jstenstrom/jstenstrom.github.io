@article{MachineHist,
  abbr              = {NYSEA},
  bibtex_show       = {true},
  title             = {History of Machinery and Political Cartoons},
  author            = {Jacob Stenstrom},
  abstract          = {The introduction of the technological advances has, throughout history, been met with a reactionary force from the society it is introduced to. At its core societies heightened distaste of machines is a reflection of humanities interactions with the structure of capitalism. To understand the relationship between humanity and machinery, the medium of political cartoons is analyzed as a window into past and present tensions. The forces that separates humanity from its work already existed, but the introduction of new technology creates a greater acknowledgment of that separation.},
  journal           = {Proceedings Of the New York State Economics Association},
  location          = {New York},
  volume            = {11},
  pages             = {7--17},
  year              = {2018},
  month             = {Oct},
  publisher         = {New York State Economic Association},
  url               = {https://www.nyseconomicsassociation.org/conference-proceedings/},
  pdf               = {https://www.nyseconomicsassociation.org/wp-content/uploads/2022/06/conference-proceedings-2018.pdf#page=10},
  dimensions        = {true},
  selected          = {true}
}
